# Copy this file to ".env" and fill in the three Supabase values.
# Find them in Supabase: Project Settings > API.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-public-key-here
# Keep this one secret. Never put it in the website code or share it.
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

PORT=3000
